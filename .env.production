# ── Production build (VPS, single domain) ──────────────────────────
#
# Loaded only when `vite build` runs with mode=production, which is what
# `npm run build` and the Dockerfile both do. Read from a file rather than
# inline shell env-vars on purpose: Git Bash rewrites POSIX-looking values
# (MSYS path conversion) and would bake a broken base path — `VITE_BASE=/`
# became `/Program Files/Git/` once, and the page loaded zero scripts.
#
# ── This file used to describe the GitHub Pages deployment ────────
#
# It held VITE_BASE=/pawsmarket/, VITE_HASH_ROUTER=true and a Railway API URL.
# All three were correct for Pages and all three are wrong for a domain:
#
#   · /pawsmarket/ was the project-page subpath. On pawsmarket.ir the site is
#     at the root, so a base of /pawsmarket/ makes index.html request
#     /pawsmarket/assets/... and the page loads no scripts at all.
#   · The hash router existed because Pages cannot rewrite unknown paths (it
#     answers its own 404). nginx can and does — see nginx.conf's try_files —
#     so URLs are clean again and /explore survives a refresh.
#   · The Railway URL pointed at a different backend than the one being
#     deployed. Empty means same-origin, which is the point of a single domain.
#
# Nothing is lost by this: Pages was last published 2026-10-15 and is 91
# commits behind main, with no workflow or script anywhere that publishes it.
# The old values stay in git history if it is ever revived — and the right way
# to revive it is an Action that builds on push, not a file kept current for a
# site nobody deploys.

# The site is served from the root of the domain, not a subpath.
VITE_BASE=/

# nginx has an SPA fallback, so a direct load of /explore returns the app.
# Only GitHub Pages needs hash URLs.
VITE_HASH_ROUTER=false

# Empty on purpose. With the API behind the same origin (/api/* is proxied to
# the backend by nginx), the browser resolves requests against the page origin
# and there is no CORS on the hot path. This is also why mediaUrl() and asset()
# need no change: they already build relative URLs when this is empty.
VITE_API_BASE_URL=
