# ── Production build (GitHub Pages) ────────────────────────────────
# Loaded ONLY when `vite build` runs (mode=production). Kept out of
# inline shell env-vars on purpose: Git Bash rewrites POSIX-looking
# values (MSYS path conversion) and would bake a broken base path.
#
# Project page lives at https://<user>.github.io/pawsmarket/
VITE_BASE=/pawsmarket/
# No SPA fallback on Pages → hash URLs (/#/explore) for deep links
VITE_HASH_ROUTER=true

# Backend: the FastAPI service on Railway. Live fetches (no static snapshot),
# so auth, pet profiles, moments, stories and adoption all work for visitors
# of the Pages build — not just browse.
VITE_API_BASE_URL=https://api-production-2527.up.railway.app
