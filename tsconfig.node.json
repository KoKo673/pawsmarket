{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    // DOM is here for the tests only, and it is a type declaration: it adds no
// runtime code and cannot reach the bundle (this project has `noEmit`).
// A test that imports a module touching `window` needs the types of that
// module's own file graph, and the browser modules are exactly the ones
// worth testing.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Unit tests live beside the code but this is the only project in the
     build that carries `types: ["node"]`, which `node:test` needs. The app
     project excludes them so `process`, `Buffer` and friends cannot leak
     into browser code. */
  "include": ["vite.config.ts", "src/**/*.test.ts"]
}
