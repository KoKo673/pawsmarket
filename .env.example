# ── PawsMarket environment template ────────────────────────────────
# Copy to `.env`; personal overrides go in `.env.local`, which wins.
#
# Both files are read by `loadEnv(mode, root, '')` in vite.config.ts — the
# explicit '' prefix is why non-VITE_ vars (DEV_PROXY_TARGET, HTTPS_DEV)
# work here at all. Only VITE_ vars reach the browser bundle.

# ── Dev server ─────────────────────────────────────────────────────
# Where `vite dev` forwards `/api`. The browser calls same-origin `/api/*`
# and vite.config.ts proxies those to this target, so there is no CORS in
# development. Point it at whichever backend you are testing against:
#
#   http://localhost:9650                          local FastAPI container
#   https://api-production-2527.up.railway.app     deployed API
#
# A wrong port here fails silently: the proxy forwards to a dead socket and
# pages render their empty state rather than an error, which reads like a
# data problem instead of a config one.
DEV_PROXY_TARGET=http://localhost:9650

# HTTPS_DEV=1 serves the dev server over HTTPS so geolocation works from a
# phone on the local network. Uses a self-signed cert.
# HTTPS_DEV=1

# ── Build ──────────────────────────────────────────────────────────
# Backend base URL baked into the production bundle, where no dev proxy
# exists. Leave empty when the API is served from the same origin as the
# app (the browser then resolves `/api/...` against the page origin).
VITE_API_BASE_URL=

# VITE_HASH_ROUTER=true switches BrowserRouter to HashRouter. The GitHub
# Pages build needs it: Pages answers its own 404 for unknown paths, so a
# direct load of /explore would never reach the app.
# VITE_HASH_ROUTER=true

# VITE_CATALOG_MODE=static ships a catalog.json snapshot instead of calling
# the API, and rejects every social call with an explanatory message.
# VITE_CATALOG_MODE=static
