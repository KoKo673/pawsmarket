# ── PawsMarket environment template ────────────────────────────────
# Copy to `.env` (or `.env.local` for personal overrides).
#
# Flask + PostGIS backend base URL. In development this is the
# Vite dev-proxy TARGET: the browser calls same-origin `/api/*` and
# vite.config.ts forwards those requests here — no CORS.
# Production: serve the static build behind the same origin as the API
# (or point your reverse proxy's /api at this URL).
VITE_API_BASE_URL=http://localhost:9232
