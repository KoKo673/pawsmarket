# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Audit scratch: the throwaway build serve_dist.mjs serves, plus its reports.
# Rebuild with `npx vite build --mode audit --outDir dist-audit`.
dist-audit
_audit/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
scripts/.overpass-cache/

# Harvest scratch: resumable progress markers, not source
scripts/.store_images_done.json
scripts/*.tmp

# stale build artefact committed by accident (b0c3b43)
assets/

# Python bytecode from the test scripts
__pycache__/
*.pyc

# Database dumps: contain password hashes and live session tokens.
*.dump
backups/

# Virtualenvs. A venv writes its own `.gitignore` containing `*`, so an
# unmodified one is already invisible to git (verified with
# `git add --dry-run .`, which selected only _args.json). This rule is for
# the case that bypasses that: a venv created at a path that already had
# files, or one whose own .gitignore was deleted. 65 MB of Windows binaries
# in history is not recoverable by deleting the file later.
.venv*/
venv/
